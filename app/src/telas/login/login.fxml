<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="620.0" prefWidth="720.0" spacing="14.0" styleClass="tela" stylesheets="@../componentes/prova.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
    <VBox alignment="CENTER" maxWidth="800.0" prefHeight="261.0" prefWidth="461.0" spacing="14.0" styleClass="card">
        <Label fx:id="codigoLabel" styleClass="subtitulo" text="" />
        <VBox spacing="5.0"><Label fx:id="lbl_registro" styleClass="secao" text="REGISTRO" />
         <TextField fx:id="txt_registro" prefHeight="43.0" prefWidth="417.0" promptText="EX.:  SGP-A1234" /></VBox>
        <VBox spacing="5.0" />
        <VBox spacing="5.0" />
        <VBox spacing="5.0" />
        <VBox spacing="5.0" />
        <HBox alignment="CENTER" spacing="10.0">
            <Button fx:id="btn_sair" mnemonicParsing="false" onAction="#sair" prefHeight="40.0" prefWidth="110.0" styleClass="botao-perigo" text="Sair" textFill="#cc3232">
            <cursor>
               <Cursor fx:constant="HAND" />
            </cursor></Button>
            <Button fx:id="btn_entrar" mnemonicParsing="false" onAction="#entrar" prefHeight="40.0" prefWidth="130.0" styleClass="botao-primario" text="Entrar">
            <cursor>
               <Cursor fx:constant="HAND" />
            </cursor></Button>
        </HBox>
    </VBox>
</VBox>
