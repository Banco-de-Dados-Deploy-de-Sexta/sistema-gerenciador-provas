<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import telas.componentes.Logo?>
<?import javafx.scene.shape.Polygon?>
<?import java.lang.Double?><?import javafx.scene.effect.GaussianBlur?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="tela" stylesheets="@../componentes/prova.css, @login.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <!-- Fundo: esboço da tela de provas, desfocado -->
    <HBox mouseTransparent="true" spacing="10.0">
        <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
        <effect><GaussianBlur radius="18.0" /></effect>

        <VBox minWidth="268.0" prefWidth="268.0" spacing="14.0" styleClass="fundo-painel">
            <Region maxWidth="120.0" styleClass="fundo-linha, clara" />
            <Region maxWidth="170.0" styleClass="fundo-linha, forte" />
            <Region styleClass="fundo-divisor" />
            <Region maxWidth="150.0" styleClass="fundo-linha, azul" />
            <Region maxWidth="160.0" styleClass="fundo-linha, azul" />
            <Region maxWidth="140.0" styleClass="fundo-linha, azul" />
            <Region maxWidth="150.0" styleClass="fundo-linha, azul" />
            <Region maxWidth="130.0" styleClass="fundo-linha, azul" />
            <Region maxWidth="170.0" styleClass="fundo-linha, azul" />
            <Region maxWidth="160.0" styleClass="fundo-linha, azul" />
        </VBox>

        <HBox spacing="15.0" styleClass="fundo-painel" HBox.hgrow="ALWAYS">
            <VBox minWidth="276.0" prefWidth="276.0" spacing="10.0" styleClass="fundo-lista">
                <VBox spacing="8.0" styleClass="fundo-card, selecionado">
                    <Region maxWidth="70.0" styleClass="fundo-linha, clara" />
                    <Region maxWidth="190.0" styleClass="fundo-linha, forte" />
                    <Region maxWidth="150.0" styleClass="fundo-linha, clara" />
                </VBox>
                <VBox spacing="8.0" styleClass="fundo-card">
                    <Region maxWidth="70.0" styleClass="fundo-linha, clara" />
                    <Region maxWidth="170.0" styleClass="fundo-linha, forte" />
                    <Region maxWidth="160.0" styleClass="fundo-linha, clara" />
                </VBox>
                <VBox spacing="8.0" styleClass="fundo-card">
                    <Region maxWidth="70.0" styleClass="fundo-linha, clara" />
                    <Region maxWidth="200.0" styleClass="fundo-linha, forte" />
                    <Region maxWidth="130.0" styleClass="fundo-linha, clara" />
                </VBox>
                <VBox spacing="8.0" styleClass="fundo-card">
                    <Region maxWidth="70.0" styleClass="fundo-linha, clara" />
                    <Region maxWidth="160.0" styleClass="fundo-linha, forte" />
                    <Region maxWidth="150.0" styleClass="fundo-linha, clara" />
                </VBox>
                <VBox spacing="8.0" styleClass="fundo-card">
                    <Region maxWidth="70.0" styleClass="fundo-linha, clara" />
                    <Region maxWidth="180.0" styleClass="fundo-linha, forte" />
                    <Region maxWidth="140.0" styleClass="fundo-linha, clara" />
                </VBox>
            </VBox>

            <VBox spacing="14.0" HBox.hgrow="ALWAYS">
                <padding><Insets left="20.0" right="20.0" top="25.0" /></padding>
                <VBox prefHeight="220.0" spacing="12.0" styleClass="fundo-card">
                    <Region maxWidth="90.0" styleClass="fundo-linha, clara" />
                    <Region maxWidth="380.0" styleClass="fundo-linha, forte" />
                    <Region maxWidth="300.0" styleClass="fundo-linha, clara" />
                    <Region maxWidth="320.0" styleClass="fundo-linha, clara" />
                    <Region maxWidth="280.0" styleClass="fundo-linha, clara" />
                </VBox>
                <VBox prefHeight="220.0" spacing="12.0" styleClass="fundo-card">
                    <Region maxWidth="90.0" styleClass="fundo-linha, clara" />
                    <Region maxWidth="340.0" styleClass="fundo-linha, forte" />
                    <Region maxWidth="310.0" styleClass="fundo-linha, clara" />
                    <Region maxWidth="260.0" styleClass="fundo-linha, clara" />
                </VBox>
            </VBox>
        </HBox>
    </HBox>

    <!-- Véu claro para dar contraste ao formulário -->
    <Region mouseTransparent="true" styleClass="fundo-veu" />

    <!-- Painel lateral: título no topo e formulário no centro exato -->
    <StackPane maxWidth="380.0" styleClass="card, login-painel" StackPane.alignment="CENTER_RIGHT">
        <VBox maxHeight="-Infinity" spacing="16.0" StackPane.alignment="TOP_LEFT">
            <HBox alignment="TOP_RIGHT">
                <Button fx:id="btn_sair" mnemonicParsing="false" onAction="#sair" styleClass="login-sair" text="Sair" />
            </HBox>
            <VBox spacing="2.0">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Logo tamanho="30.0">
                        <HBox.margin><Insets right="4.0" /></HBox.margin>
                    </Logo>
                    <Label styleClass="login-titulo" text="Gerenciador de Provas" />
                    <Label fx:id="lbl_info" styleClass="login-info" text="i">
                        <tooltip>
                            <Tooltip maxWidth="280.0" showDelay="150ms" styleClass="login-info-dica" wrapText="true"
                                     text="Entre com o registro fornecido pela instituição (por exemplo, SGP-A1234). Professores acessam o painel de provas; alunos acessam as provas associadas a eles." />
                        </tooltip>
                    </Label>
                </HBox>
            </VBox>
        </VBox>

        <VBox maxHeight="-Infinity" spacing="6.0" StackPane.alignment="CENTER">
            <Label fx:id="lbl_registro" styleClass="secao" text="REGISTRO" />
            <TextField fx:id="txt_registro" styleClass="login-campo" />
            <Label fx:id="lbl_erro" managed="false" styleClass="login-erro" visible="false" wrapText="true" />
        </VBox>

        <!-- Botão Entrar com um triângulo retângulo azul no canto inferior direito;
             os catetos acompanham a borda de baixo e a borda direita do botão -->
        <StackPane maxHeight="-Infinity" maxWidth="-Infinity" StackPane.alignment="BOTTOM_RIGHT">
            <Button fx:id="btn_entrar" defaultButton="true" mnemonicParsing="false" onAction="#entrar"
                    prefWidth="110.0" styleClass="botao-primario, login-entrar" text="Entrar" />
            <Polygon mouseTransparent="true" styleClass="login-entrar-canto" StackPane.alignment="BOTTOM_RIGHT">
                <points>
                    <Double fx:value="16.0" /><Double fx:value="0.0" />
                    <Double fx:value="16.0" /><Double fx:value="16.0" />
                    <Double fx:value="0.0" /><Double fx:value="16.0" />
                </points>
            </Polygon>
        </StackPane>
    </StackPane>
</StackPane>
