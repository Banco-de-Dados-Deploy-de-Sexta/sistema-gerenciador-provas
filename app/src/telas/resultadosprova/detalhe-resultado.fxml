<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" styleClass="tela" stylesheets="@../componentes/prova.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
    </padding>

    <VBox spacing="5.0">
        <Label fx:id="tituloTela" styleClass="titulo" text="Desempenho do aluno" />
        <Label fx:id="alunoLabel" styleClass="step-title" text="Aluno" wrapText="true" />
        <Label fx:id="notaFinalLabel" styleClass="resultado" text="Nota final" wrapText="true" />
        <Label styleClass="subtitulo"
               text="Veja a resposta enviada, o gabarito e a pontuação de cada questão."
               wrapText="true" />
    </VBox>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
        <content>
            <VBox fx:id="questoesContainer" spacing="12.0">
                <padding><Insets bottom="8.0" left="4.0" right="4.0" top="4.0" /></padding>
            </VBox>
        </content>
    </ScrollPane>

    <HBox alignment="CENTER_RIGHT">
        <Button mnemonicParsing="false" onAction="#voltar" styleClass="botao-secundario" text="Voltar aos resultados" />
    </HBox>
</VBox>
