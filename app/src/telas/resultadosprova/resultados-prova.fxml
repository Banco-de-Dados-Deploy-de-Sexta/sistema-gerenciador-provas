<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="tela" stylesheets="@../componentes/prova.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
    </padding>

    <VBox spacing="6.0">
        <Label fx:id="tituloTela" styleClass="titulo" text="Resultados da prova" wrapText="true" />
        <Label styleClass="subtitulo"
               text="As notas são exibidas em uma escala de 0 a 10. Clique em um aluno para consultar as respostas e a correção questão por questão."
               wrapText="true" />
    </VBox>

    <HBox spacing="14.0">
        <VBox maxWidth="1.7976931348623157E308" styleClass="indicador-card" HBox.hgrow="ALWAYS">
            <Label styleClass="secao" text="NOTA MÉDIA" />
            <Label fx:id="mediaLabel" styleClass="indicador-valor" text="—" />
            <Label styleClass="indicador-contexto" text="Entre as notas lançadas" />
        </VBox>
        <VBox maxWidth="1.7976931348623157E308" styleClass="indicador-card" HBox.hgrow="ALWAYS">
            <Label styleClass="secao" text="MAIOR NOTA" />
            <Label fx:id="maiorNotaLabel" styleClass="indicador-valor" text="—" />
            <Label styleClass="indicador-contexto" text="Nota mais alta da turma" />
        </VBox>
        <VBox maxWidth="1.7976931348623157E308" styleClass="indicador-card" HBox.hgrow="ALWAYS">
            <Label styleClass="secao" text="MENOR NOTA" />
            <Label fx:id="menorNotaLabel" styleClass="indicador-valor" text="—" />
            <Label styleClass="indicador-contexto" text="Nota mais baixa da turma" />
        </VBox>
    </HBox>

    <VBox spacing="10.0" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label styleClass="step-title" text="Notas dos alunos" />
            <Label fx:id="resumoLabel" styleClass="subtitulo" HBox.hgrow="ALWAYS" />
        </HBox>
        <TableView fx:id="tabelaResultados" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="registroColumn" prefWidth="180.0" text="ID do aluno" />
                <TableColumn fx:id="nomeColumn" prefWidth="450.0" text="Nome" />
                <TableColumn fx:id="notaColumn" prefWidth="220.0" text="Nota (0–10)" />
            </columns>
        </TableView>
    </VBox>

    <HBox alignment="CENTER_RIGHT">
        <Button mnemonicParsing="false" onAction="#voltar" styleClass="botao-secundario" text="Voltar" />
    </HBox>
</VBox>
