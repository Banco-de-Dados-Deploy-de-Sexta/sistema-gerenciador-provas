<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import telas.componentes.Icones?>

<VBox
        spacing="10.0"
        stylesheets="@../../componentes/tema.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1">

    <TextArea
            fx:id="enunciadoCaixaTexto"
            prefRowCount="3"
            promptText="Digite o enunciado da questão"
            styleClass="campo-questao"
            wrapText="true" />

    <Label text="Afirmações" styleClass="questao-titulo" />
    <Label
            text="Cadastre cada afirmação e indique se é verdadeira ou falsa. A sequência será montada como gabarito, por exemplo: V, V, F, V."
            wrapText="true" />

    <TextArea
            fx:id="afirmacaoCaixaTexto"
            prefRowCount="2"
            promptText="Digite uma afirmação"
            styleClass="campo-alternativa"
            wrapText="true" />

    <fx:define>
        <ToggleGroup fx:id="respostaAfirmacaoGroup" />
    </fx:define>

    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Label text="Resposta correta:" />
        <RadioButton
                fx:id="verdadeiroRadioButton"
                text="V"
                toggleGroup="$respostaAfirmacaoGroup" />
        <RadioButton
                fx:id="falsoRadioButton"
                text="F"
                toggleGroup="$respostaAfirmacaoGroup" />
        <Region HBox.hgrow="ALWAYS" />
        <Button
                mnemonicParsing="false"
                onAction="#adicionarAfirmacao"
                styleClass="botao-claro"
                text="Adicionar afirmação">
            <graphic>
                <SVGPath scaleX="0.7" scaleY="0.7" styleClass="icone">
                    <content>
                        <Icones fx:constant="ADICIONAR" />
                    </content>
                </SVGPath>
            </graphic>
        </Button>
    </HBox>

    <VBox fx:id="listaAfirmacoes" spacing="8.0" />

    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Label text="Sequência correta:" />
        <Label fx:id="sequenciaLabel" text="—" styleClass="questao-peso" />
    </HBox>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button
                mnemonicParsing="false"
                onAction="#confirmar"
                styleClass="botao-claro, primario"
                text="Confirmar" />
    </HBox>
</VBox>
