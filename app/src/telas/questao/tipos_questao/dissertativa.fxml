<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" stylesheets="@../../componentes/tema.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <TextArea fx:id="enunciadoCaixaTexto" prefRowCount="3"
              promptText="Digite o enunciado da questão"
              styleClass="campo-questao" wrapText="true" />

    <VBox spacing="6.0" styleClass="card-questao">
        <padding><Insets bottom="14.0" left="14.0" right="14.0" top="14.0" /></padding>
        <Label styleClass="questao-titulo" text="Resposta dissertativa" />
        <Label text="O aluno escreverá a resposta durante a prova. Depois da entrega, o professor atribuirá uma nota entre zero e o peso definido para esta questão."
               wrapText="true" />
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button mnemonicParsing="false" onAction="#confirmar"
                styleClass="botao-claro, primario" text="Confirmar" />
    </HBox>
</VBox>
