<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import telas.componentes.Icones?>

<HBox
        spacing="10.0"
        styleClass="tela"
        stylesheets="@../componentes/tema.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1">

    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
    </padding>

    <!-- MENU LATERAL -->
    <VBox
            minWidth="268.0"
            prefWidth="268.0"
            styleClass="menu-lateral">

        <Button
                maxWidth="1.7976931348623157E308"
                mnemonicParsing="false"
                onAction="#confirmar"
                styleClass="botao-menu"
                text="Confirmar">

            <graphic>
                <SVGPath styleClass="icone">
                    <content>
                        <Icones fx:constant="CONFIRMAR"/>
                    </content>
                </SVGPath>
            </graphic>

        </Button>

        <Button
                maxWidth="1.7976931348623157E308"
                mnemonicParsing="false"
                onAction="#voltar"
                styleClass="botao-menu"
                text="Cancelar">

            <graphic>
                <SVGPath styleClass="icone">
                    <content>
                        <Icones fx:constant="CANCELAR"/>
                    </content>
                </SVGPath>
            </graphic>

        </Button>

    </VBox>

    <!-- CONTEÚDO -->
    <HBox
            styleClass="conteudo"
            HBox.hgrow="ALWAYS">

        <!-- LISTA DE QUESTÕES -->
        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                minWidth="276.0"
                prefWidth="276.0"
                styleClass="lista-cards">

            <content>
                <VBox fx:id="listaQuestoes" styleClass="lista-cards-conteudo" />
            </content>

        </ScrollPane>

        <!-- DETALHES -->
        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                styleClass="detalhe"
                HBox.hgrow="ALWAYS">

            <content>

                <VBox alignment="TOP_CENTER">

                    <padding>
                        <Insets bottom="10.0"
                                left="10.0"
                                right="10.0"
                                top="25.0"/>
                    </padding>

                    <VBox
                            maxWidth="597.0"
                            styleClass="painel-questoes">

                        <VBox
                                spacing="10.0"
                                styleClass="card-questao">

                            <!-- CABEÇALHO -->
                            <HBox alignment="CENTER_LEFT">

                                <Label
                                        fx:id="numeroLabel"
                                        styleClass="questao-numero"
                                        text="1)"/>

                                <Label
                                        fx:id="tituloTela"
                                        styleClass="questao-titulo"
                                        text="Nova questão"/>

                            </HBox>

                            <!-- SELEÇÃO DO TIPO -->
                            <Label text="Tipo de questão"/>

                            <ComboBox
                                    fx:id="tipoQuestaoComboBox"
                                    maxWidth="1.7976931348623157E308"
                                    promptText="Selecione o tipo de questão"
                                    onAction="#selecionarTipoQuestao"/>

                            <!-- FORMULÁRIO DINÂMICO -->
                            <StackPane fx:id="formularioContainer" minHeight="300.0" />

                        </VBox>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </HBox>

</HBox>
