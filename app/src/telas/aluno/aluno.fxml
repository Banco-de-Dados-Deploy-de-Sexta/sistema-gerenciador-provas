<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.shape.SVGPath?>
<?import telas.componentes.Icones?>

<StackPane
    stylesheets="@../componentes/tema.css"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1">

    <HBox spacing="10.0"
          styleClass="tela">

        <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
        </padding>

        <VBox minWidth="268.0"
              prefWidth="268.0"
              styleClass="menu-lateral">

            <VBox styleClass="usuario-logado">
                <Label styleClass="usuario-logado-rotulo" text="Aluno(a)" />
                <Label fx:id="nomeUsuario"
                       styleClass="usuario-logado-nome"
                       text=""
                       wrapText="true" />
                <Label fx:id="registroUsuario"
                       styleClass="usuario-logado-registro"
                       text=""
                       wrapText="true" />
            </VBox>

            <Button fx:id="realizarButton"
                    maxWidth="1.7976931348623157E308"
                    mnemonicParsing="false"
                    onAction="#realizarProva"
                    styleClass="botao-menu"
                    text="Realizar prova">

                <graphic>
                    <SVGPath styleClass="icone">
                        <content>
                            <Icones fx:constant="ADICIONAR" />
                        </content>
                    </SVGPath>
                </graphic>

            </Button>

            <Region VBox.vgrow="ALWAYS" />

            <Button maxWidth="1.7976931348623157E308"
                    mnemonicParsing="false"
                    onAction="#voltar"
                    styleClass="botao-menu"
                    text="Sair / Voltar">

                <graphic>
                    <SVGPath styleClass="icone">
                        <content>
                            <Icones fx:constant="VOLTAR" />
                        </content>
                    </SVGPath>
                </graphic>

            </Button>

        </VBox>

        <HBox styleClass="conteudo" HBox.hgrow="ALWAYS">

            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        minWidth="276.0"
                        prefWidth="276.0"
                        styleClass="lista-cards">

                <content>
                    <VBox fx:id="listaProvas"
                          styleClass="lista-cards-conteudo" />
                </content>

            </ScrollPane>

            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        styleClass="detalhe"
                        HBox.hgrow="ALWAYS">

                <content>
                    <VBox alignment="TOP_CENTER">

                        <padding>
                            <Insets bottom="10.0"
                                    left="10.0"
                                    right="10.0"
                                    top="25.0" />
                        </padding>

                        <VBox fx:id="questoesProva"
                              maxWidth="597.0"
                              styleClass="painel-questoes" />

                    </VBox>
                </content>

            </ScrollPane>

        </HBox>

    </HBox>

    <!-- Botão Refresh Flutuante -->
    <Button fx:id="refreshButton"
            mnemonicParsing="false"
            onAction="#atualizarProvas"
            styleClass="botao-menu botao-claro primario"
            StackPane.alignment="TOP_RIGHT"
            translateX="-20"
            translateY="20">

        <graphic>
            <SVGPath styleClass="icone">
                <content>
                    <Icones fx:constant="ATUALIZAR" />
                </content>
            </SVGPath>
        </graphic>

    </Button>

</StackPane>