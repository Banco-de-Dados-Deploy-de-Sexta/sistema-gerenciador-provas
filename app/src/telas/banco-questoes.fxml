<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" spacing="14.0" styleClass="tela" stylesheets="@banco-questoes.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="telas.BancoQuestoesController">
    <padding><Insets bottom="32.0" left="32.0" right="32.0" top="32.0" /></padding>
    <VBox alignment="CENTER" maxWidth="560.0" spacing="12.0" styleClass="empty-card">
        <Label styleClass="empty-icon" text="▤" />
        <Label styleClass="title" text="Banco de questões" />
        <Label styleClass="description" text="Suas questões cadastradas aparecerão aqui. Comece criando a primeira questão pelo menu lateral." wrapText="true" />
        <Button mnemonicParsing="false" onAction="#voltar" styleClass="secondary-button" text="Voltar para o início" />
    </VBox>
</VBox>
