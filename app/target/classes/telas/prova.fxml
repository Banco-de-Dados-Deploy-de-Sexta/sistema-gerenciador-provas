<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="16.0" styleClass="tela" stylesheets="@prova.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding><Insets bottom="24.0" left="28.0" right="28.0" top="24.0" /></padding>
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox spacing="3.0"><Label styleClass="titulo" text="Provas" /><Label styleClass="subtitulo" text="Cadastre provas, vincule questões e faça a correção automática." /></VBox>
        <HBox alignment="CENTER_RIGHT" spacing="8.0" HBox.hgrow="ALWAYS">
            <Button mnemonicParsing="false" onAction="#novaProva" styleClass="botao-primario" text="Nova prova" />
            <Button fx:id="editarButton" mnemonicParsing="false" onAction="#editarProva" styleClass="botao-secundario" text="Editar" />
            <Button fx:id="excluirButton" mnemonicParsing="false" onAction="#excluirProva" styleClass="botao-perigo" text="Excluir" />
        </HBox>
    </HBox>
    <TableView fx:id="tabelaProvas" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colunaCodigo" prefWidth="100.0" text="Código" />
            <TableColumn fx:id="colunaTitulo" prefWidth="310.0" text="Título" />
            <TableColumn fx:id="colunaMateria" prefWidth="250.0" text="Matéria" />
            <TableColumn fx:id="colunaCurso" prefWidth="180.0" text="Curso" />
            <TableColumn fx:id="colunaBimestre" prefWidth="90.0" text="Bimestre" />
            <TableColumn fx:id="colunaData" prefWidth="110.0" text="Data" />
        </columns>
    </TableView>
    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Button fx:id="questoesButton" mnemonicParsing="false" onAction="#gerenciarQuestoes" styleClass="botao-primario" text="Questões e pesos" />
        <Button fx:id="corrigirButton" mnemonicParsing="false" onAction="#corrigir" styleClass="botao-secundario" text="Corrigir respostas" />
        <HBox HBox.hgrow="ALWAYS" />
        <Button mnemonicParsing="false" onAction="#voltar" styleClass="botao-secundario" text="Voltar" />
    </HBox>
</VBox>
