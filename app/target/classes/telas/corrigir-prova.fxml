<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="12.0" styleClass="tela" stylesheets="@prova.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding><Insets bottom="20.0" left="24.0" right="24.0" top="20.0" /></padding>
    <Label fx:id="tituloTela" styleClass="titulo" text="Corrigir prova" />
    <Label styleClass="subtitulo" text="Marque as respostas. A pontuação soma o peso das alternativas corretas." wrapText="true" />
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
        <content><VBox fx:id="listaQuestoes" spacing="10.0"><padding><Insets bottom="8.0" left="4.0" right="4.0" top="4.0" /></padding></VBox></content>
    </ScrollPane>
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <Button mnemonicParsing="false" onAction="#corrigir" styleClass="botao-primario" text="Calcular resultado" />
        <Label fx:id="resultadoLabel" styleClass="resultado" text="" />
        <HBox HBox.hgrow="ALWAYS" />
        <Button mnemonicParsing="false" onAction="#voltar" styleClass="botao-secundario" text="Voltar" />
    </HBox>
</VBox>
