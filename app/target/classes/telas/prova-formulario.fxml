<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="TOP_CENTER" prefHeight="620.0" prefWidth="720.0" spacing="14.0" styleClass="tela" stylesheets="@prova.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
    <VBox maxWidth="800.0" spacing="14.0" styleClass="card">
        <Label fx:id="tituloTela" styleClass="titulo" text="Nova prova" />
        <Label fx:id="codigoLabel" styleClass="subtitulo" text="" />
        <VBox spacing="5.0"><Label styleClass="secao" text="TÍTULO" /><TextField fx:id="tituloCaixaTexto" promptText="Título da prova" /></VBox>
        <VBox spacing="5.0"><Label styleClass="secao" text="MATÉRIA" /><TextField fx:id="materiaCaixaTexto" promptText="Matéria (até 50 caracteres)" /></VBox>
        <VBox spacing="5.0"><Label styleClass="secao" text="CURSO" /><TextField fx:id="cursoCaixaTexto" promptText="Curso (até 50 caracteres)" /></VBox>
        <VBox spacing="5.0"><Label styleClass="secao" text="BIMESTRE" /><TextField fx:id="bimestreCaixaTexto" promptText="1 a 4" /></VBox>
        <VBox spacing="5.0"><Label styleClass="secao" text="DATA DA PROVA" /><DatePicker fx:id="dataPicker" promptText="Opcional" /></VBox>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Button mnemonicParsing="false" onAction="#voltar" prefHeight="40.0" prefWidth="110.0" styleClass="botao-secundario" text="Voltar" />
            <Button mnemonicParsing="false" onAction="#confirmar" prefHeight="40.0" prefWidth="130.0" styleClass="botao-primario" text="Salvar prova" />
        </HBox>
    </VBox>
</VBox>
