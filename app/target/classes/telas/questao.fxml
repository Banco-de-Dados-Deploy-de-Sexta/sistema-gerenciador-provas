<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="520.0" prefWidth="645.0" styleClass="tela" stylesheets="@questao.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="telas.QuestaoController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <VBox fx:id="painel" spacing="18.0" styleClass="card" VBox.vgrow="ALWAYS">

        <Label styleClass="titulo" text="Questão 1" />

        <VBox spacing="6.0">
            <Label styleClass="secao" text="ENUNCIADO" />
            <TextField fx:id="enunciadoCaixaTexto" promptText="Digite o enunciado da questão" />
        </VBox>

        <VBox spacing="6.0">
            <Label styleClass="secao" text="NOVA ALTERNATIVA" />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <TextField fx:id="perguntaCaixaTexto" promptText="Texto da alternativa" HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#adicionarAlternativa" styleClass="botao-secundario" text="+ Adicionar alternativa" />
            </HBox>
        </VBox>

        <VBox spacing="6.0" VBox.vgrow="ALWAYS">
            <Label styleClass="secao" text="ALTERNATIVAS" />
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="lista-alternativas" VBox.vgrow="ALWAYS">
                <content>
                    <GridPane fx:id="gridAlternativas" hgap="10.0" vgap="8.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="NEVER" minWidth="40.0" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                        </columnConstraints>
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding>
                    </GridPane>
                </content>
            </ScrollPane>
        </VBox>

        <HBox alignment="CENTER_RIGHT">
            <Button mnemonicParsing="false" onAction="#confirmar" prefHeight="40.0" prefWidth="130.0" styleClass="botao-primario" text="Confirmar" />
        </HBox>

    </VBox>
</VBox>