<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="16.0" styleClass="tela" stylesheets="@banco-questoes.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding><Insets bottom="24.0" left="28.0" right="28.0" top="24.0" /></padding>
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox spacing="3.0"><Label styleClass="title" text="Banco de questões" /><Label styleClass="description" text="Crie, consulte, edite ou exclua questões." /></VBox>
        <HBox alignment="CENTER_RIGHT" spacing="8.0" HBox.hgrow="ALWAYS">
            <Button mnemonicParsing="false" onAction="#novaQuestao" styleClass="primary-button" text="Nova questão" />
            <Button fx:id="visualizarButton" mnemonicParsing="false" onAction="#visualizarQuestao" styleClass="secondary-button" text="Visualizar" />
            <Button fx:id="editarButton" mnemonicParsing="false" onAction="#editarQuestao" styleClass="secondary-button" text="Editar" />
            <Button fx:id="excluirButton" mnemonicParsing="false" onAction="#excluirQuestao" styleClass="danger-button" text="Excluir" />
        </HBox>
    </HBox>
    <TableView fx:id="tabelaQuestoes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colunaId" prefWidth="90.0" text="ID" />
            <TableColumn fx:id="colunaEnunciado" prefWidth="550.0" text="Enunciado" />
            <TableColumn fx:id="colunaAlternativas" prefWidth="140.0" text="Alternativas" />
        </columns>
    </TableView>
    <HBox alignment="CENTER_RIGHT"><Button mnemonicParsing="false" onAction="#voltar" styleClass="secondary-button" text="Voltar" /></HBox>
</VBox>
