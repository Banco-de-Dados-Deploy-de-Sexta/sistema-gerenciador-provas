<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="440.0" prefWidth="645.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.provas.app.controladores.HomeControlador">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Pane fx:id="painel" prefHeight="400.0" prefWidth="605.0">
      <children>
         <Label alignment="BOTTOM_LEFT" layoutX="14.0" layoutY="14.0" nodeOrientation="LEFT_TO_RIGHT" prefHeight="47.0" prefWidth="193.0" text="1) Questão 1" textAlignment="JUSTIFY">
            <font>
               <Font size="32.0" />
            </font>
         </Label>
         <ButtonBar layoutX="4.0" layoutY="358.0" prefHeight="40.0" prefWidth="600.0">
            <buttons>
             <Button minWidth="0.0" mnemonicParsing="false" prefHeight="40.0" prefWidth="97.0" text="Confirmar">
                  <cursor>
                     <Cursor fx:constant="HAND" />
                  </cursor>
               </Button>
            </buttons>
         </ButtonBar>
         <TextField layoutX="42.0" layoutY="76.0" prefHeight="110.0" prefWidth="496.0" />
         <Button layoutX="459.0" layoutY="206.0" mnemonicParsing="false" onAction="#adicionarAlternativa" text="Adicionar alternativa" />
         <ScrollPane fitToWidth="true" layoutX="36.0" layoutY="250.0" prefHeight="100.0" prefWidth="502.0" style="-fx-background-color: transparent;">
            <content>
               <GridPane fx:id="gridAlternativas" hgap="10.0" vgap="8.0">
                 <columnConstraints>
                   <ColumnConstraints hgrow="NEVER" minWidth="40.0" />
                   <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                 </columnConstraints>
                 <padding>
                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                 </padding>
               </GridPane>
            </content>
         </ScrollPane>
         <Text layoutX="42.0" layoutY="226.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Pergunta alternativa" />
         <TextField fx:id="perguntaCaixaTexto" layoutX="170.0" layoutY="208.0" prefHeight="26.0" prefWidth="275.0" />
      </children>
   </Pane>
   <cursor>
      <Cursor fx:constant="DEFAULT" />
   </cursor>
</VBox>
